rules_version = '2';

// Kist Book — Firestore security rules.
//
// Privacy model:
//   * Every user's data lives under /users/{uid}/... and ONLY that user can
//     read or write it. Nobody else — not other users, not staff — can see it.
//   * The app is read-only by design: customer records are never edited by
//     hand. They change only through statement/outstanding imports, which the
//     app matches by A/C No. before writing.
//   * One account per phone number / email is enforced by Firebase Auth
//     itself (it refuses to create a second account for the same identifier).
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner-only access to everything under their own user node.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
